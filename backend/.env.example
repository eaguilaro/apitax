# Archivo de ejemplo de variables de entorno
# Copia este archivo a .env y configura con tus valores

# Puerto del servidor
PORT=3001

# Conexión a MongoDB
# Local:
MONGODB_URI=mongodb://localhost:27017/apitax

# O usando MongoDB Atlas (nube):
# MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/apitax?retryWrites=true&w=majority

# Ambiente
NODE_ENV=development
# En producción, define el origen HTTPS de la aplicación.
# FRONTEND_ORIGIN=https://mi-dominio.example

# Directorio de recibos. Las rutas relativas se resuelven desde backend/.
UPLOAD_DIR=./uploads

# Autenticación de un solo usuario: genera valores locales nuevos antes del primer arranque.
# No guardes secretos aquí; este ejemplo sí se versiona.
# AUTH_SETUP_TOKEN=<random bootstrap token>
# JWT_SECRET=<random secret of at least 32 characters>
# AUTH_TOTP_ENCRYPTION_KEY=<64 hexadecimal characters>
